<?xml version="1.0"?>
<ruleset name="MultiStepFormBuilder">
  <description>PHP_CodeSniffer rules for Multi Step Form Builder plugin.</description>

  <!-- Scan these paths -->
  <file>includes</file>
  <file>tests</file>

  <!-- Exclude common non-PHP paths -->
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>

  <!-- WordPress Coding Standards -->
  <rule ref="WordPress">
    <exclude name="WordPress.Files.FileName"/>
    <exclude name="WordPress.Files.ClassStructure.MissingNamespace"/>
    <exclude name="WordPress.Files.FileHeader.Missing"/>
    <exclude name="WordPress.Files.ClassStructure.MissingClassDocBlock"/>
    <exclude name="WordPress.Files.FunctionUse.MultipleUseOnly"/>
    <exclude name="Squiz.Commenting.FileComment"/>
    <exclude name="Squiz.Commenting.FunctionComment"/>
    <exclude name="Squiz.Commenting.ClassComment"/>
  </rule>
</ruleset>
