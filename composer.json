{
  "name": "jpjuliao/multi-step-form-builder",
  "description": "Multi Step Form Builder for WordPress",
  "type": "wordpress-plugin",
  "require": {
    "php": "^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "wp-phpunit/wp-phpunit": "^6.0",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "wp-coding-standards/wpcs": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "JPJULIAO\\Wordpress\\MultiStepFormBuilder\\": "includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "JPJULIAO\\Wordpress\\MultiStepFormBuilder\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "phpcs --standard=WordPress includes tests",
    "lint-fix": "phpcbf --standard=WordPress includes tests",
    "test": "phpunit"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}